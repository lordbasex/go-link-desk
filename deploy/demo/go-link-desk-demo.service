#
# go-link Desk's public demonstration host (desk.go-link.org/demo): the
# test card, every viewer let in without asking, their input only logged,
# no clipboard or files. A user unit (~/.config/systemd/user), with its own
# settings folder, so it runs beside a normal go-link Desk on the same
# computer. See README.md.
[Unit]
Description=go-link Desk demonstration host
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/go-link-desk-demo/go-link-desk --headless \
  --config %h/.config/go-link-desk-demo/device.json \
  --source testpattern --test-auto-accept --test-input-log \
  --test-clipboard-file %h/.config/go-link-desk-demo/clipboard.txt \
  --test-name "go-link Desk Demo" \
  --test-code-file %h/.config/go-link-desk-demo/demo.json
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
