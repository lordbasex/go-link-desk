#
# Uploads demo.json to the website (publish.py). The key, which may write
# that one object only, is in aws.env (mode 600).
[Unit]
Description=Publish the go-link Desk demo code
StartLimitIntervalSec=0

[Service]
Type=oneshot
EnvironmentFile=%h/.config/go-link-desk-demo/aws.env
ExecStart=/usr/bin/python3 %h/go-link-desk-demo/publish.py %h/.config/go-link-desk-demo/demo.json
